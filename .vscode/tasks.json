{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GE: dev server",
      "type": "shell",
      "command": "npm run dev -w packages/web-shell -- --host 0.0.0.0",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "GE: generate dev manifests",
      "type": "shell",
      "command": "npm run manifests:generate -- --profile development && npm run manifests:validate -- --profile development",
      "problemMatcher": []
    },
    {
      "label": "GE: package dev",
      "type": "shell",
      "command": "npm run build && npm run package:dev",
      "dependsOn": ["GE: generate dev manifests"],
      "problemMatcher": []
    },
    {
      "label": "GE: install unified package",
      "type": "shell",
      "command": "atk install --file-path dist/release/development-m365-v0.1.0.zip",
      "dependsOn": ["GE: package dev"],
      "problemMatcher": []
    },
    {
      "label": "GE: checks",
      "type": "shell",
      "command": "npm run typecheck && npm run lint && npm run test",
      "problemMatcher": []
    }
  ]
}
