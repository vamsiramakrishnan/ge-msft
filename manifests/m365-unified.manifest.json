{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.23/MicrosoftTeams.schema.json",
  "manifestVersion": "1.23",
  "id": "REPLACE_WITH_APP_GUID",
  "version": "0.1.0",
  "name": { "short": "Gemini Enterprise", "full": "Gemini Enterprise for Microsoft 365" },
  "description": {
    "short": "Grounded Gemini Enterprise agents across Office and Teams.",
    "full": "Brings Gemini Enterprise into Word, Excel, PowerPoint, and Teams — grounded on a curated research unit, scoped to your identity, with traceable changes."
  },
  "developer": {
    "name": "REPLACE_DEVELOPER",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "icons": { "color": "icon-color.png", "outline": "icon-outline.png" },
  "accentColor": "#5B5FC7",

  "webApplicationInfo": {
    "id": "REPLACE_ENTRA_CLIENT_ID",
    "resource": "api://REPLACE_WEB_SHELL_DOMAIN/REPLACE_ENTRA_CLIENT_ID"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        { "name": "OnlineMeetingTranscript.Read.Chat", "type": "Application" }
      ]
    }
  },
  "validDomains": ["REPLACE_WEB_SHELL_DOMAIN", "login.microsoftonline.com"],

  "staticTabs": [
    {
      "entityId": "gemini-tab",
      "name": "Gemini",
      "contentUrl": "https://REPLACE_WEB_SHELL_DOMAIN/?host=teams",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "REPLACE_BOT_ID",
      "scopes": ["personal", "team", "groupChat"],
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": []
    }
  ],
  "composeExtensions": [
    {
      "botId": "REPLACE_BOT_ID",
      "commands": [
        {
          "id": "groundOnUnit",
          "type": "query",
          "title": "Ground on the unit",
          "description": "Ask Gemini about this, grounded on your research unit.",
          "initialRun": false,
          "parameters": [{ "name": "q", "title": "Question", "description": "What to ask" }]
        }
      ]
    }
  ],

  "extensions": [
    {
      "requirements": {
        "scopes": ["mail", "workbook", "document", "presentation"],
        "capabilities": [
          { "name": "Mailbox", "minVersion": "1.12" },
          { "name": "WordApi", "minVersion": "1.3" },
          { "name": "ExcelApi", "minVersion": "1.7" }
        ]
      },
      "runtimes": [
        {
          "id": "taskpane_runtime",
          "type": "general",
          "code": { "page": "https://REPLACE_WEB_SHELL_DOMAIN/taskpane.html" },
          "lifetime": "short",
          "actions": [{ "id": "openPanel", "type": "openPage", "view": "Gemini" }]
        },
        {
          "id": "commands_runtime",
          "type": "general",
          "code": {
            "page": "https://REPLACE_WEB_SHELL_DOMAIN/commands.html",
            "script": "https://REPLACE_WEB_SHELL_DOMAIN/assets/commands.js"
          },
          "lifetime": "short",
          "actions": [
            { "id": "openGemini", "type": "executeFunction" },
            { "id": "onMessageSend", "type": "executeFunction" },
            { "id": "askSelection", "type": "executeFunction" }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "builtInTabId": "TabHome",
              "groups": [
                {
                  "id": "geminiGroup",
                  "label": "Gemini Enterprise",
                  "controls": [
                    {
                      "id": "openGeminiBtn",
                      "type": "button",
                      "label": "Open Gemini",
                      "actionId": "openPanel",
                      "icons": [
                        { "size": 16, "url": "icon-16.png" },
                        { "size": 32, "url": "icon-32.png" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "contextMenus": [
        {
          "requirements": { "scopes": ["document", "workbook", "presentation"] },
          "menus": [
            {
              "id": "geminiAskMenu",
              "type": "menuItem",
              "label": "Ask Gemini about this",
              "supertip": {
                "title": "Ask Gemini",
                "description": "Summarize or review the current selection in the Gemini pane."
              },
              "actionId": "askSelection"
            }
          ]
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "capabilities": [{ "name": "Mailbox", "minVersion": "1.12" }],
            "scopes": ["mail"]
          },
          "events": [
            {
              "type": "messageSending",
              "actionId": "onMessageSend",
              "options": { "sendMode": "softBlock" }
            }
          ]
        }
      ]
    }
  ]
}
