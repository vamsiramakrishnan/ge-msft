{
  "name": "gemini-m365-addin",
  "private": true,
  "version": "0.0.0",
  "description": "Gemini Enterprise multi-surface add-in for Microsoft 365 (Word, Excel, PowerPoint, OneNote, Teams).",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "echo \"Run a specific workspace, e.g. npm run dev -w packages/web-shell\"",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/office-js": "^1.0.377",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-check": "^4.8.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
