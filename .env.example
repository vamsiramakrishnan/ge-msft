# ---- Google Cloud / Gemini Enterprise (gateway only) ----
GCP_PROJECT=your-gcp-project
GCP_REGION=australia-southeast1               # pin to tenant residency
DISCOVERY_ENGINE_LOCATION=eu                  # global | us | eu | ... (match residency)
GEMINI_ENTERPRISE_APP_ID=your-engine-id       # the Gemini Enterprise app/engine id
AGENT_ENGINE_REVIEW_AGENT=projects/.../reasoningEngines/...   # A2A endpoint of the Review agent

# ---- Identity federation: Microsoft Entra -> Google Workforce Identity ----
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=gateway-app-client-id
ENTRA_CLIENT_SECRET=                          # via Secret Manager in prod, never committed
WORKFORCE_POOL_ID=your-workforce-pool
WORKFORCE_PROVIDER_ID=your-entra-provider
WORKFORCE_POOL_PROJECT_NUMBER=000000000000

# ---- Connectors (Entra app registered as the Gemini Enterprise connector) ----
SHAREPOINT_TENANT_URL=https://your-tenant.sharepoint.com
CONNECTOR_DEFAULT_MODE=federated              # prefer federated for ad-hoc sources

# ---- Guardrails / safety ----
MODEL_ARMOR_TEMPLATE=projects/.../locations/.../templates/...

# ---- Gateway runtime ----
PORT=8080
WEB_SHELL_ORIGIN=https://localhost:3000       # CORS allow-list for the web-shell
LOG_LEVEL=info
BIGQUERY_AUDIT_DATASET=addin_audit

# ---- Web-shell (client) ----
VITE_GATEWAY_URL=https://localhost:8080
VITE_ENTRA_CLIENT_ID=client-app-client-id     # the NAA app registration (client-side, public)
