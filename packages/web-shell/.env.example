# ---- @ge/web-shell (client-direct, ADR-0001) ----
# Copy to packages/web-shell/.env and fill in. These are CLIENT values, surfaced to the browser by
# Vite (the VITE_ prefix). NONE of them is a secret: no Google service-account key, no client
# secret. The only secret in play is the user's own short-lived Entra token, acquired at runtime
# via MSAL Nested App Authentication. Do NOT put ENTRA_CLIENT_SECRET or any Google key here.

# -- Gemini Enterprise (Discovery Engine) coordinates --
VITE_GCP_PROJECT=your-gcp-project-id            # GCP project id or number
VITE_GCP_LOCATION=eu                            # global | us | eu | <region> — pin to residency
VITE_GE_ENGINE=your-engine-id                   # the Gemini Enterprise app/engine id
VITE_GE_COLLECTION=default_collection           # optional (default: default_collection)
VITE_GE_ASSISTANT=default_assistant             # optional (default: default_assistant)
VITE_GE_MODEL_ID=                               # optional model override; blank = engine default

# -- Workforce Identity Federation (the Entra id token federates to this pool/provider) --
VITE_WIF_POOL_ID=your-workforce-pool
VITE_WIF_PROVIDER_ID=your-entra-provider
VITE_WIF_SCOPE=                                 # optional; blank = cloud-platform
VITE_WIF_USER_PROJECT=                          # optional billing/quota project for STS

# -- Microsoft Entra (MSAL NAA — public client, no secret) --
VITE_ENTRA_CLIENT_ID=client-app-client-id       # the NAA app registration (public)
VITE_ENTRA_AUTHORITY=                            # optional, e.g. https://login.microsoftonline.com/<tenant>
VITE_WIF_ID_TOKEN_SCOPES=                        # space/comma-separated scopes yielding the WIF subject id token
VITE_GRAPH_SCOPES=User.Read                      # least-privilege delegated Graph scopes; add narrow,
                                                 # source-scoped reads (prefer Sites.Selected over *.All)

# -- Optional --
VITE_PROXY_URL=                                  # optional audited/CORS egress proxy (https); blank = direct
VITE_NOTEBOOK_ID=                                # optional NotebookLM notebook id seeding the research unit
