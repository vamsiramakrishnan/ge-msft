{
  "name": "gemini-m365-addin",
  "private": true,
  "version": "1.0.3",
  "description": "Gemini Enterprise add-ins for Microsoft 365, with a controlled Word + Excel internal alpha release profile.",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "dev": "vite --config packages/web-shell/vite.preview.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate:manifests": "vitest run packages/contracts/src/manifest-lint.test.ts packages/contracts/src/manifest-generation.test.ts",
    "manifests:generate": "bun tools/release/manifests-generate.mjs",
    "manifests:validate": "bun tools/release/manifests-validate.mjs",
    "package:dev": "bun tools/release/package-dev.mjs",
    "package:alpha": "bun tools/release/package-alpha.mjs",
    "release:web": "bun scripts/release-web.mjs",
    "deploy:web": "bun run release:web && bunx firebase-tools deploy --only hosting",
    "release:check": "bun tools/release/release-check.mjs",
    "release:secret-scan": "bun tools/release/secret-scan.mjs",
    "release:checksums": "bun tools/release/checksums.mjs --verify",
    "entra:sync:dev": "bun tools/release/sync-entra-spa.mjs --profile development",
    "entra:sync:release": "bun tools/release/sync-entra-spa.mjs --profile internal-alpha-word-excel",
    "setup:guide": "bun scripts/setup-cli.mjs guide",
    "setup:doctor": "bun scripts/setup-cli.mjs doctor",
    "setup:doctor:fix": "bun scripts/setup-cli.mjs doctor --fix",
    "setup:prereqs": "bun scripts/setup-cli.mjs prereqs",
    "setup:deps": "bun scripts/setup-cli.mjs prereqs --target deps",
    "setup:azure": "bun scripts/setup-cli.mjs prereqs --target azure",
    "setup:gcloud": "bun scripts/setup-cli.mjs prereqs --target gcloud",
    "setup:gcloud:wif": "bun scripts/setup-cli.mjs login --target gcloud",
    "setup:gcloud:wif:force": "bun scripts/setup-cli.mjs login --target gcloud --force",
    "setup:gcloud:wif:extend": "bun scripts/setup-cli.mjs login --target wif-extend",
    "setup:atk": "bun scripts/setup-cli.mjs prereqs --target atk",
    "setup:atk:login": "bun scripts/setup-cli.mjs login --target atk",
    "setup:powershell": "bun scripts/setup-cli.mjs prereqs --target powershell,exchange",
    "setup:cloudflared": "bun scripts/setup-cli.mjs prereqs --target cloudflared",
    "setup:login": "bun scripts/setup-cli.mjs login",
    "setup:package": "bun scripts/setup-cli.mjs package",
    "sideload": "bun scripts/setup-cli.mjs sideload install",
    "sideload:uninstall": "bun scripts/setup-cli.mjs sideload uninstall",
    "sideload:status": "bun scripts/setup-cli.mjs sideload status",
    "bootstrap": "bun scripts/setup-cli.mjs bootstrap",
    "bootstrap:dev": "bun scripts/setup-cli.mjs bootstrap --profile development --deployment-lane none --dev-tunnel",
    "bootstrap:dev:sideload": "bun scripts/setup-cli.mjs sideload install",
    "bootstrap:release": "bun scripts/setup-cli.mjs bootstrap --profile internal-alpha-word-excel --deployment-lane catalog",
    "bootstrap:release:dry-run": "bun scripts/setup-cli.mjs bootstrap --profile internal-alpha-word-excel --deployment-lane catalog --dry-run",
    "bootstrap:prod": "bun run bootstrap:release",
    "setup:bootstrap": "bun scripts/setup-cli.mjs bootstrap",
    "ge:dev:tunnel": "bun scripts/setup-cli.mjs dev-tunnel",
    "ge:skills": "bun scripts/setup-cli.mjs skills",
    "ge:skills:force-token": "scripts/update-ge-widget-skills.sh --force-token-refresh",
    "m365:addins": "bun scripts/setup-cli.mjs addins",
    "m365:sideload": "bun scripts/setup-cli.mjs sideload",
    "m365:catalog": "bun scripts/setup-cli.mjs catalog",
    "skills:generate": "bun run emit:language && python3 skill/generate_resource_index.py",
    "skills:check": "bun run emit:language:check && python3 skill/generate_resource_index.py --check",
    "skills:validate": "python3 skill/validate_skill_bundles.py --check-zip",
    "skills:validate:official": "uvx --from skills-ref agentskills validate skill/m365-command-planner && uvx --from skills-ref agentskills validate skill/m365-surface-commander && uvx --from skills-ref agentskills validate skill/m365-release-operator",
    "skills:index": "python3 skill/generate_resource_index.py",
    "test:streamassist:live": "GE_LIVE_STREAMASSIST=1 vitest run packages/gemini-client/src/stream-assist.live.test.ts --testTimeout=120000",
    "test:streamassist:latency": "GE_LIVE_STREAMASSIST=1 GE_LIVE_STREAMASSIST_SCENARIOS=smoke-basic,commander-excel-visualize,commander-word-surgical,planner-single-surface GE_LIVE_STREAMASSIST_REPETITIONS=3 vitest run packages/gemini-client/src/stream-assist.live.test.ts --testTimeout=120000",
    "test:streamassist:widget": "GE_LIVE_STREAMASSIST=1 GE_LIVE_STREAMASSIST_TRANSPORT=widget vitest run packages/gemini-client/src/stream-assist.live.test.ts --testTimeout=120000",
    "test:streamassist:live:login": "bun scripts/streamassist-live-login.mjs",
    "probe:streamassist-code-exec": "bun scripts/streamassist-code-exec-probe.mjs",
    "coverage": "vitest run --coverage",
    "docs:gifs:install": "bunx playwright install --with-deps chromium",
    "docs:gifs": "bun scripts/render-readme-gifs.mjs",
    "docs:gifs:check": "bun scripts/render-readme-gifs.mjs --check",
    "emit:language": "tsc -b packages/contracts && bun packages/contracts/scripts/emit-language-manifest.mjs",
    "emit:language:check": "tsc -b packages/contracts && bun packages/contracts/scripts/emit-language-manifest.mjs --check"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^20.14.0",
    "@types/office-js": "^1.0.377",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "commander": "^15.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-check": "^4.8.0",
    "gifenc": "^1.0.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
