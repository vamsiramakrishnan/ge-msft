{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "id": "REPLACE_WITH_APP_GUID",
  "version": "0.1.0",
  "name": { "short": "Gemini Enterprise", "full": "Gemini Enterprise for Microsoft 365" },
  "description": {
    "short": "Grounded Gemini Enterprise agents across Office and Teams.",
    "full": "Brings Gemini Enterprise into Word, Excel, PowerPoint, and Teams — grounded on a curated research unit, scoped to your identity, with traceable changes."
  },
  "developer": {
    "name": "REPLACE_DEVELOPER",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "icons": { "color": "icon-color.png", "outline": "icon-outline.png" },
  "accentColor": "#5B5FC7",

  "webApplicationInfo": {
    "id": "REPLACE_ENTRA_CLIENT_ID",
    "resource": "api://REPLACE_GATEWAY_DOMAIN/REPLACE_ENTRA_CLIENT_ID"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        { "name": "OnlineMeetingTranscript.Read.Chat", "type": "Application" }
      ]
    }
  },
  "validDomains": ["REPLACE_GATEWAY_DOMAIN", "REPLACE_WEB_SHELL_DOMAIN"],

  "staticTabs": [
    {
      "entityId": "gemini-tab",
      "name": "Gemini",
      "contentUrl": "https://REPLACE_WEB_SHELL_DOMAIN/?host=teams",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "REPLACE_BOT_ID",
      "scopes": ["personal", "team", "groupChat"],
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": []
    }
  ],
  "composeExtensions": [
    {
      "botId": "REPLACE_BOT_ID",
      "commands": [
        {
          "id": "groundOnUnit",
          "type": "query",
          "title": "Ground on the unit",
          "description": "Ask Gemini about this, grounded on your research unit.",
          "initialRun": false,
          "parameters": [{ "name": "q", "title": "Question", "description": "What to ask" }]
        }
      ]
    }
  ],

  "extensions": [
    {
      "requirements": { "scopes": ["mail", "workbook", "document", "presentation"] },
      "runtimes": [
        {
          "id": "taskpane_runtime",
          "type": "general",
          "code": { "page": "https://REPLACE_WEB_SHELL_DOMAIN/taskpane.html" },
          "lifetime": "short",
          "actions": [{ "id": "openPanel", "type": "openPage", "view": "Gemini" }]
        }
      ],
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "builtInTabId": "TabHome",
              "groups": [
                {
                  "id": "geminiGroup",
                  "label": "Gemini Enterprise",
                  "controls": [
                    {
                      "id": "openGeminiBtn",
                      "type": "button",
                      "label": "Open Gemini",
                      "actionId": "openPanel",
                      "icons": [{ "size": 16, "url": "icon-16.png" }, { "size": 32, "url": "icon-32.png" }]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
